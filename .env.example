# Copie para .env e preencha (nunca commite o .env — está no .gitignore).
# django-environ: SECRET_KEY, DEBUG, DATABASE_URL e ALLOWED_HOSTS são lidos em config/settings.py

SECRET_KEY=altere-para-uma-chave-secreta-longa-e-aleatoria
DEBUG=False
ALLOWED_HOSTS=reboqueja.seudominio.com

# PostgreSQL — usados pelo container reboqueja-db e pela URL de conexão do Django
POSTGRES_DB=reboqueja
POSTGRES_USER=reboqueja
POSTGRES_PASSWORD=troque_para_senha_segura
DATABASE_URL=postgresql://reboqueja:troque_para_senha_segura@reboqueja-db:5432/reboqueja
