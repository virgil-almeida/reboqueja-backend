# Copie para .env e preencha (nunca commite o .env — está no .gitignore).
# django-environ: SECRET_KEY, DEBUG, DATABASE_URL e ALLOWED_HOSTS são lidos em config/settings.py

SECRET_KEY=altere-para-uma-chave-secreta-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# PostgreSQL local ou URL do provedor (Render/Railway)
DATABASE_URL=postgres://usuario:senha@localhost:5432/reboqueja

# Em produção (Render/Railway), o host costuma injetar PORT; o Procfile usa $PORT no Gunicorn.
